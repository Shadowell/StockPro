# StockPro environment example. Copy to backend/.env and keep real secrets private.

API_PREFIX=/api
PROJECT_NAME=Stock Analysis App

# Isolation golden path used by ./scripts/check.sh.
# Create it with: ./scripts/setup_isolation_db.sh
# 127.0.0.1:55432 is local docker isolation OR an SSH tunnel, not a stockpro_dev copy.
DATABASE_URL=postgresql://stockpro:stockpro@127.0.0.1:55432/stockpro_bitpro_rebase_dev
DATABASE_ADMIN_URL=postgresql://stockpro:stockpro@127.0.0.1:55432/postgres
DATABASE_SSH_HOST=your-db-ssh-host
DATABASE_SSH_REMOTE_HOST=127.0.0.1
DATABASE_SSH_REMOTE_PORT=5432

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_TOKEN_SECRET=change-this-random-secret
ADMIN_TOKEN_TTL_SECONDS=43200

QWEN_API_KEY=
QWEN_STOCK_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# A 股实盘工作台（默认关闭：仅预检与审计留痕，不发出真实委托）
LIVE_TRADING_ENABLED=false
EXTENSION_HTTP_ALLOWED_HOSTS=[]
LIVE_MINIQMT_ENABLED=false
LIVE_PTRADE_ENABLED=false
LIVE_MAX_SINGLE_ORDER_VALUE=200000
LIVE_MAX_POSITION_WEIGHT=0.3
LIVE_MAX_DAILY_LOSS_RATIO=0.05
TUSHARE_TOKEN=
TUSHARE_CREDIT_TIER=5000
TUSHARE_REALTIME_SOURCE=dc
ENABLE_TUSHARE=true
AKSHARE_TIMEOUT=30

RUN_MIGRATIONS_ON_STARTUP=false
RUN_BOOTSTRAP_ON_STARTUP=false
RUN_PAPER_RECOVERY_ON_STARTUP=false
ENABLE_SCHEDULER=true
ENABLE_LOCAL_PG_BACKUP=false
LOCAL_PG_BACKUP_CRON=30 2 * * *
ENABLE_REALTIME_SYNC=false
ENABLE_STRATEGY_EXECUTION=false
ENABLE_EXTERNAL_MARKET_FETCH=false

BACKEND_CORS_ORIGINS=["http://localhost:4444","http://127.0.0.1:4444"]
ENFORCE_OPERATION_ALLOWLIST=false
OPERATION_ALLOWLIST=[]
